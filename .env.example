APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# Run migrations with this role. Generate a unique password; never commit it.
MIGRATION_DB_USER="attendance_migration"
MIGRATION_DB_PASSWORD="replace-with-a-random-migration-password"
POSTGRES_DB="school_attendance"

# Run the web and worker with this non-owner role.
APP_DB_USER="attendance_app"
APP_DB_PASSWORD="replace-with-a-random-application-password"
DATABASE_URL="postgres://attendance_app:replace-with-a-random-application-password@localhost:5432/school_attendance"
# Used only by authentication and the SMS worker; keep it separate from the web role.
SYSTEM_DB_USER="attendance_system"
SYSTEM_DB_PASSWORD="replace-with-a-random-system-password"
SYSTEM_DATABASE_URL="postgres://attendance_system:replace-with-a-random-system-password@localhost:5432/school_attendance"
# Dedicated database connection for auth functions (bypasses RLS safely via SECURITY DEFINER)
AUTH_DB_USER="attendance_auth"
AUTH_DB_PASSWORD="replace-with-a-random-auth-password"
AUTH_DATABASE_URL="postgres://attendance_auth:replace-with-a-random-auth-password@localhost:5432/school_attendance"

# Master encryption key for envelope and secret key derivation (KMS local HSM mode, min 32 chars)
KMS_MASTER_KEY="replace-with-a-random-32-byte-kms-master-key-012345678"

# Redis shared rate limiting & coordination infrastructure.
REDIS_URL="redis://localhost:6379"
# Secret key used for HMAC-SHA256 rate limit key hashing (must be at least 32 bytes).
REDIS_KEY_HMAC_SECRET="replace-with-a-random-32-byte-redis-hmac-secret-012345678"

# Prometheus metrics bearer authentication token (must be set in production).
METRICS_AUTH_TOKEN="replace-with-a-random-32-byte-metrics-auth-token-012345678"

# Number of trusted reverse proxy hops (e.g., 1 for single Nginx/Ingress proxy).
TRUSTED_PROXIES="1"

# Generate at least 32 random bytes for session secret; never use this example value.
SESSION_SECRET="replace-with-a-random-session-secret"

# Use a real provider in production. fake is for development/test only unless
# ALLOW_FAKE_SMS_IN_PRODUCTION=true is explicitly set for a controlled pilot.
SMS_PROVIDER="fake"
ALLOW_FAKE_SMS_IN_PRODUCTION="false"
SMS_WORKER_INTERVAL_MS="5000"
WORKER_HEARTBEAT_FILE="/tmp/worker-heartbeat"

# ==============================================================================
# RFID / NFC Attendance Configuration
# ==============================================================================

# WARNING: Using UID legacy mode is insecure and vulnerable to card cloning.
# Only enable if explicitly required by old hardware that cannot be upgraded.
ALLOW_LEGACY_RFID_UID_MODE="false"

# Secret used to HMAC signatures for scan payloads (Must be at least 32 chars).
# REQUIRED in production.
RFID_HMAC_SECRET="replace-with-a-random-32-byte-rfid-hmac-secret-012345678"

# Key rotation version for HMAC signatures.
RFID_HMAC_KEY_VERSION="1"

# Prevent duplicate consecutive taps from the same card (default: 30000 ms / 30s)
RFID_DUPLICATE_TAP_COOLDOWN_MS="30000"

# Maximum allowed clock skew between reader and server for replay protection (default: 30000 ms)
RFID_MAX_CLOCK_SKEW_MS="30000"

# Maximum time an offline scan remains valid before being rejected (default: 24 hours)
RFID_MAX_OFFLINE_DURATION_HOURS="24"

# Maximum age of the cached student roster in the reader (default: 4 hours)
RFID_MAX_ROSTER_AGE_HOURS="4"

# Maximum number of offline scans the reader should store before failing (default: 10000)
RFID_OFFLINE_QUEUE_CAPACITY="10000"

# Behavior when offline queue is full or roster is too old: "CLOSED" (reject all) or "OPEN" (allow all and reconcile later)
RFID_OFFLINE_FAIL_MODE="CLOSED"

# Rate limit for incoming scan payloads per minute per reader (default: 120)
RFID_READER_SCAN_RATE_LIMIT="120"

# Optional: Internal URL of the reader gateway microservice (if running separately)
# RFID_GATEWAY_URL="http://localhost:4000"
