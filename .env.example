APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# Run migrations with this role. Generate a unique password; never commit it.
MIGRATION_DB_USER="attendance_migration"
MIGRATION_DB_PASSWORD="replace-with-a-random-migration-password"
POSTGRES_DB="school_attendance"

# Run the web and worker with this non-owner role.
APP_DB_USER="attendance_app"
APP_DB_PASSWORD="replace-with-a-random-application-password"
DATABASE_URL="postgres://attendance_app:replace-with-a-random-application-password@localhost:5432/school_attendance"

# Generate at least 32 random bytes; never use this example value.
SESSION_SECRET="replace-with-a-random-session-secret"
