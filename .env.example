APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# Run migrations with this role. Generate a unique password; never commit it.
MIGRATION_DB_USER="attendance_migration"
MIGRATION_DB_PASSWORD="replace-with-a-random-migration-password"
POSTGRES_DB="school_attendance"

# Run the web and worker with this non-owner role.
APP_DB_USER="attendance_app"
APP_DB_PASSWORD="replace-with-a-random-application-password"
DATABASE_URL="postgres://attendance_app:replace-with-a-random-application-password@localhost:5432/school_attendance"
# Used only by authentication and the SMS worker; keep it separate from the web role.
SYSTEM_DB_USER="attendance_system"
SYSTEM_DB_PASSWORD="replace-with-a-random-system-password"
SYSTEM_DATABASE_URL="postgres://attendance_system:replace-with-a-random-system-password@localhost:5432/school_attendance"

# Redis shared rate limiting & coordination infrastructure.
REDIS_URL="redis://localhost:6379"
# Secret key used for HMAC-SHA256 rate limit key hashing (must be at least 32 bytes).
REDIS_KEY_HMAC_SECRET="replace-with-a-random-32-byte-redis-hmac-secret-012345678"

# Prometheus metrics bearer authentication token (must be set in production).
METRICS_AUTH_TOKEN="replace-with-a-random-32-byte-metrics-auth-token-012345678"

# Number of trusted reverse proxy hops (e.g., 1 for single Nginx/Ingress proxy).
TRUSTED_PROXIES="1"

# Generate at least 32 random bytes for session secret; never use this example value.
SESSION_SECRET="replace-with-a-random-session-secret"

# Use a real provider in production. fake is for development/test only unless
# ALLOW_FAKE_SMS_IN_PRODUCTION=true is explicitly set for a controlled pilot.
SMS_PROVIDER="fake"
ALLOW_FAKE_SMS_IN_PRODUCTION="false"
SMS_WORKER_INTERVAL_MS="5000"
WORKER_HEARTBEAT_FILE="/tmp/worker-heartbeat"
