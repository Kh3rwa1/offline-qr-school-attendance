# GENERATED by scripts/gen-env-example.ts — edit src/env.ts instead.

# ── Server & Process ────────────────────────────────────────
# Application runtime environment (development, test, production)
NODE_ENV=production

# Process role to execute (web, worker, migrate)
COMPONENT=web

# HTTP server listening port
PORT=3000

# Canonical public base URL of the AttendEase web portal
APP_URL=http://localhost:3000

# Pino structured logging level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Number of active web application replicas running behind proxy
WEB_REPLICA_COUNT=2

# Timeout in ms to wait for in-flight requests to complete during SIGTERM drain
SHUTDOWN_DRAIN_MS=20000

# Delay in ms between unmarking readiness check and closing server listeners
SHUTDOWN_READINESS_GRACE_MS=3000

# ── Database & Connection Pools ─────────────────────────────
# PostgreSQL connection URL for school tenant operations (RLS enforced)
DATABASE_URL=postgres://attendease_app:password@localhost:5432/attendease

# PostgreSQL connection URL for system/migration operations (must be isolated role)
SYSTEM_DATABASE_URL=postgres://attendease_sys:password@localhost:5432/attendease

# PostgreSQL connection URL for authentication and credential verification
AUTH_DATABASE_URL=postgres://attendease_auth:password@localhost:5432/attendease

# Custom application_name tag sent to PostgreSQL for connection identification
PG_APPLICATION_NAME=attendease-web

# Minimum idle connections maintained per pool
PG_POOL_MIN=2

# Fallback global maximum pool size override
PG_POOL_MAX=20

# Maximum database connections dedicated to tenant app pool
PG_POOL_MAX_APP=10

# Maximum database connections dedicated to system/maintenance pool
PG_POOL_MAX_SYS=5

# Milliseconds an idle connection can remain open before being closed
PG_IDLE_TIMEOUT_MS=30000

# Milliseconds to wait before timing out while acquiring a connection from the pool
PG_CONNECTION_TIMEOUT_MS=5000

# PostgreSQL statement timeout limit in milliseconds per query
PG_STATEMENT_TIMEOUT_MS=10000

# PostgreSQL idle_in_transaction_session_timeout in milliseconds
PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=5000

# Cluster-wide safety cap on total allowed database connections
MAX_ALLOWED_DB_CONNECTIONS=100

# ── Redis Cache & Rate Limiting ─────────────────────────────
# Full connection URL for Redis cache and rate limiting service
REDIS_URL=redis://localhost:6379

# Redis hostname when not using REDIS_URL
REDIS_HOST=localhost

# Redis TCP port when not using REDIS_URL
REDIS_PORT=6379

# Redis password authentication credential (SECRET — generated by install.sh, never commit)
REDIS_PASSWORD=

# HMAC key used to hash student identifiers in Redis cache keys (SECRET — generated by install.sh, never commit)
REDIS_KEY_HMAC_SECRET=

# ── Session & Security ──────────────────────────────────────
# HMAC secret key used to sign and encrypt session cookies (min 32 chars) (SECRET — generated by install.sh, never commit)
SESSION_SECRET=

# HMAC key used for CSRF double-submit token verification (min 32 chars) (SECRET — generated by install.sh, never commit)
CSRF_SECRET=

# Shared secret verified on incoming reverse proxy forwarded headers (SECRET — generated by install.sh, never commit)
TRUSTED_INGRESS_SECRET=

# Allow bypassing auth checks for local testing (STRICTLY FORBIDDEN in production)
ALLOW_TEST_BYPASS=false

# ── UHF RFID Gate Ingest ────────────────────────────────────
# Enable UHF RFID reader endpoints and background ingest services
FEATURE_RFID=true

# Enable high-throughput batch ingest pipeline with transaction batching
RFID_INGEST_V2=true

# Allow transitional fallback for legacy reader bearer token authentication
LEGACY_READER_BEARER_FALLBACK=false

# Server-side cryptographic pepper used when hashing reader bearer tokens at rest (SECRET — generated by install.sh, never commit)
READER_TOKEN_PEPPER=

# HMAC secret key used to compute irreversible EPC badge credential digests (SECRET — generated by install.sh, never commit)
RFID_CREDENTIAL_DIGEST_KEY=

# Shared secret for verifying reader HTTP webhook HMAC-SHA256 signatures (SECRET — generated by install.sh, never commit)
RFID_HMAC_SECRET=

# Key version identifier for active RFID HMAC secret
RFID_HMAC_KEY_VERSION=1

# Debounce window in milliseconds to suppress rapid duplicate badge reads
RFID_DUPLICATE_TAP_COOLDOWN_MS=30000

# Maximum tolerated clock skew in ms between reader and server timestamps
RFID_MAX_CLOCK_SKEW_MS=30000

# Maximum tolerated reader offline operation buffer duration in hours
RFID_MAX_OFFLINE_DURATION_HOURS=24

# Maximum allowable age of local edge roster cache in hours
RFID_MAX_ROSTER_AGE_HOURS=4

# Maximum capacity of offline scan event buffer queue
RFID_OFFLINE_QUEUE_CAPACITY=10000

# Queue full failure policy (OPEN or CLOSED)
RFID_OFFLINE_FAIL_MODE=CLOSED

# Maximum scans per minute permitted from a single reader
RFID_READER_SCAN_RATE_LIMIT=600

# Master key for reader credential signature verification (SECRET — generated by install.sh, never commit)
RFID_CARD_MASTER_KEY=

# Enforce cryptographic proof in incoming tag read events
RFID_REQUIRE_CARD_PROOF=false

# Allow legacy unhashed card UID mode (deprecated)
ALLOW_LEGACY_RFID_UID_MODE=false

# URL of internal hardware gateway relay if deployed
RFID_GATEWAY_URL=http://localhost:4000

# Symmetric encryption key for local offline scan event store (SECRET — generated by install.sh, never commit)
RFID_OUTBOX_ENCRYPTION_KEY=

# Default identifier assigned to local hardware reader
RFID_READER_ID=reader-gate-01

# Default school UUID identifier for single-tenant appliance deployment
SCHOOL_ID=a1b2c3d4-e5f6-4a1b-8c2d-3e4f5a6b7c8d

# ── KMS & Envelope Encryption ───────────────────────────────
# Master 256-bit encryption key used by local KMS provider (SECRET — generated by install.sh, never commit)
KMS_MASTER_KEY=

# AWS KMS Key ARN for cloud-managed envelope encryption
AWS_KMS_KEY_ARN=arn:aws:kms:ap-south-1:123456789012:key/example-key

# Google Cloud KMS Key Resource ID for cloud-managed envelope encryption
GCP_KMS_RESOURCE_ID=projects/p/locations/l/keyRings/r/cryptoKeys/k

# ── Telemetry & Alerting ────────────────────────────────────
# Bearer authentication token required to scrape Prometheus /metrics (SECRET — generated by install.sh, never commit)
METRICS_AUTH_TOKEN=

# HTTP webhook URL for dispatching urgent operational failure alerts
ALERT_WEBHOOK_URL=https://alerts.example.com/webhook

# ── DLT SMS & Telecom Integration ───────────────────────────
# Active SMS dispatch engine implementation (fake, console, dlt)
SMS_PROVIDER=console

# Delay window in minutes before sending absence SMS notifications to prevent false alarms
ABSENCE_SMS_DELAY_MINUTES=20

# HMAC secret for verifying inbound carrier delivery receipts (SECRET — generated by install.sh, never commit)
SMS_WEBHOOK_SECRET=

# HTTP endpoint of telecom SMS gateway provider
SMS_GATEWAY_URL=https://sms.example.com/send

# Queue poll interval in milliseconds for background SMS worker
SMS_WORKER_INTERVAL_MS=5000

# Number of SMS background worker processes running
SMS_WORKER_REPLICA_COUNT=2

# API authorization key for Indian Telecom DLT gateway provider (SECRET — generated by install.sh, never commit)
DLT_SMS_API_KEY=

# Approved 6-character TRAI DLT Header / Sender ID
DLT_SMS_SENDER_ID=SCHATT

# Registered Principal Entity ID on TRAI DLT portal
DLT_SMS_ENTITY_ID=1201159000000000000

# Base API URL for TRAI DLT telecom messaging gateway
DLT_SMS_BASE_URL=https://api.sms-provider.in/v1

# Custom header required by DLT SMS provider
DLT_SMS_HEADER=X-DLT-Header

# Secret key for verifying DLT delivery status callback webhooks (SECRET — generated by install.sh, never commit)
DLT_WEBHOOK_SECRET=

# Principal entity ID alias for secondary DLT configuration
DLT_PRINCIPAL_ENTITY_ID=1201159000000000000

# Direct API URL for DLT message dispatch endpoint
DLT_SMS_GATEWAY_URL=https://api.sms-provider.in/v1/send

# Direct webhook signature secret for DLT callbacks (SECRET — generated by install.sh, never commit)
DLT_SMS_WEBHOOK_SECRET=

# ── Backups & Disaster Recovery ─────────────────────────────
# Local filesystem directory path for encrypted database backups
BACKUP_DIR=/var/backups/attendease

# Age recipient public key or passphrase for database backup encryption (SECRET — generated by install.sh, never commit)
BACKUP_ENCRYPTION_KEY=

# Timestamp of latest verified successful backup drill
LATEST_BACKUP_TIMESTAMP=2026-10-06T00:00:00Z

# Filesystem path touched periodically by workers for liveness checks
WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat

# Cloudflare Account ID for offsite R2 replication storage
R2_ACCOUNT_ID=cf-account-id

# Cloudflare R2 S3-compatible Access Key ID
R2_ACCESS_KEY_ID=r2-access-key-id

# Cloudflare R2 S3-compatible Secret Access Key (SECRET — generated by install.sh, never commit)
R2_SECRET_ACCESS_KEY=

# Cloudflare R2 bucket name for encrypted backup archives
R2_BUCKET=attendease-backups

# S3-compatible endpoint URL for Cloudflare R2 bucket
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Key prefix / folder within Cloudflare R2 bucket
R2_PREFIX=backups/school-01

# Cloudflare R2 data storage jurisdiction (e.g., in, eu)
R2_JURISDICTION=in

# Days to retain backup archives in Cloudflare R2 storage
R2_RETENTION_DAYS=90

# Timeout in seconds for R2 backup archive upload operations
R2_UPLOAD_TIMEOUT_SECONDS=300

# Maximum retry attempts for failed R2 backup uploads
R2_MAX_RETRIES=3

# ── Reporting Engine ────────────────────────────────────────
# Maximum byte size allowed for a generated report file
REPORT_ARTIFACT_MAX_BYTES=52428800

# Storage backend for report files (local or object)
REPORT_ARTIFACT_STORAGE=local

# Directory path for storing generated report files
REPORT_ARTIFACT_DIR=/var/data/reports

# Maximum concurrent background report generation tasks
REPORT_GENERATION_CONCURRENCY=2

# Maximum pending report requests allowed in queue
REPORT_GENERATION_MAX_PENDING=10

# Upper threshold of spreadsheet cells to avoid memory exhaustion
REPORT_MAX_ESTIMATED_CELLS=1000000

# Maximum date span in days for a single attendance report
REPORT_MAX_PERIOD_DAYS=365

# Maximum student count processed in a single report generation task
REPORT_MAX_STUDENTS=5000

# ── Testing & Development Runtime ───────────────────────────
# Flag indicating execution inside automated continuous integration environment
CI=true

# Serve built static frontend bundle in test environment
TEST_SERVER_STATIC=true

# Start HTTP server listener automatically upon module execution
RUN_SERVER=true

# Flag indicating execution within the Vitest test runner
VITEST=true
