#!/usr/bin/env bash
# AttendEase CLI binary wrapper
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Invoke through bash rather than executing install.sh directly. The
# executable bit is not guaranteed to survive zip downloads, Windows
# checkouts, or API-based edits, and install.sh requires bash regardless.
exec bash "${SCRIPT_DIR}/scripts/install.sh" "$@"
