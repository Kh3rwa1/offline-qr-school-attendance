{
  "name": "offline-qr-school-attendance",
  "description": "Hybrid Offline QR + Production RFID/NFC School Attendance Platform",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/db/migrate.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/migrate.cjs && esbuild src/db/seed.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/seed.cjs && esbuild sms-worker.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/sms-worker.cjs && esbuild src/gateway/gatewayDaemon.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/gateway.cjs",
    "build:gateway": "esbuild src/gateway/gatewayDaemon.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/gateway.cjs",
    "start": "node dist/server.cjs",
    "start:gateway": "node dist/gateway.cjs",
    "lint": "tsc --noEmit",
    "check:guardrail": "tsx scripts/verify-no-forbidden-strings.ts",
    "check:claims": "tsx scripts/verify-product-claims.ts",
    "check": "tsc --noEmit && tsx scripts/verify-no-forbidden-strings.ts && tsx scripts/verify-no-inline-i18n-ternaries.ts && tsx scripts/verify-product-claims.ts",
    "test": "bash scripts/run-ci-tests.sh",
    "test:e2e": "playwright test",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "test:postgres": "tsx scripts/run-postgres-rls-suite.ts",
    "test:load-smoke": "tsx scripts/runLoadSmokeBenchmark.ts",
    "test:load-full": "tsx scripts/runFullScaleLoadTest.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:prod": "tsx src/db/seed_production.ts",
    "worker:sms": "tsx sms-worker.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tanstack/react-query": "^5.101.4",
    "@types/express-rate-limit": "^5.1.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie": "^1.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^1.1.18"
  },
  "optionalDependencies": {
    "pcsclite": "^1.0.1"
  }
}
