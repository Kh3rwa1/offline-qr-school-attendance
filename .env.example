# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g. postgres://postgres:postgres@localhost:5432/school_attendance)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/school_attendance"

# SESSION_SECRET: Secret used for session cookie encryption/signing
SESSION_SECRET="super-secret-key-change-in-production-12345"

# NODE_ENV: Application environment ('development', 'production', 'test')
NODE_ENV="development"

# PORT: Listening port (default 3000)
PORT="3000"
